  "dependencies": {
    "@slinga/api-contract": "workspace:*",
    "@slinga/route-api": "workspace:*",
    "@slinga/route-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

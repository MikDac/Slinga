{
  "name": "@slinga/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 0 route-generation quality harness (PLANNING.md §8, 0.1) — becomes the regression suite",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
